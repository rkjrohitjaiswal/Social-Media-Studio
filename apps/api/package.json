{
  "name": "@ai-social/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "vercel-build": "cd ../.. && npm install && npx prisma generate --schema=packages/database/prisma/schema.prisma && npm run build --workspace=@ai-social/shared && npm run build --workspace=@ai-social/database && cd apps/api && npm run build",
    "worker:generation": "tsx src/workers/generationWorker.ts",
    "worker:publishing": "tsx src/workers/publishingWorker.ts",
    "worker:analytics": "tsx src/workers/analyticsWorker.ts"
  },
  "dependencies": {
    "@ai-social/database": "*",
    "@ai-social/shared": "*",
    "@google-cloud/bigquery": "^9.0.2",
    "@supabase/supabase-js": "^2.112.2",
    "bullmq": "^5.41.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-social/config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
