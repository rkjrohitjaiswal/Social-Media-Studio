# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisocialstudio?schema=public"

# Supabase Auth & Private Storage Settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# OpenAI API Configuration (Server-Only)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_IMAGE_MODEL="gpt-image-2"
OPENAI_IMAGE_QUALITY="high"
OPENAI_IMAGE_SIZE="1024x1536"
OPENAI_IMAGE_OUTPUT_FORMAT="png"

# OpenAI Social Copy Engine Configuration
OPENAI_TEXT_MODEL="gpt-4o-mini"
SOCIAL_COPY_MAX_ATTEMPTS=3
SOCIAL_COPY_MAX_HASHTAGS=12

# AI Quality Scoring Engine Thresholds
QUALITY_MAX_ATTEMPTS=3
QUALITY_PASS_THRESHOLD=90
QUALITY_REVIEW_THRESHOLD=75

# Meta / Instagram Graph API Configuration (Server-Only)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/callback"
META_API_VERSION="v20.0"
INSTAGRAM_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
INSTAGRAM_PUBLISH_MAX_ATTEMPTS=3

# LinkedIn REST API & OAuth Configuration (Server-Only)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/integrations/linkedin/callback"
LINKEDIN_API_VERSION="202604"
LINKEDIN_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Meta Threads API & OAuth Configuration (Server-Only)
THREADS_APP_ID="your-threads-app-id"
THREADS_APP_SECRET="your-threads-app-secret"
THREADS_REDIRECT_URI="http://localhost:3000/api/integrations/threads/callback"
THREADS_API_VERSION="v1.0"

# Pinterest API v5 & OAuth Configuration (Server-Only)
PINTEREST_APP_ID="your-pinterest-app-id"
PINTEREST_APP_SECRET="your-pinterest-app-secret"
PINTEREST_REDIRECT_URI="http://localhost:3000/api/integrations/pinterest/callback"
PINTEREST_API_VERSION="v5"

# Meta Facebook Graph API & OAuth Configuration (Server-Only)
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/integrations/facebook/callback"
FACEBOOK_API_VERSION="v25.0"

# TikTok Content Posting API v2 & OAuth Configuration (Server-Only)
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="http://localhost:3000/api/integrations/tiktok/callback"
TIKTOK_API_VERSION="v2"

# YouTube Data API v3 & Google OAuth Configuration (Server-Only)
YOUTUBE_CLIENT_ID="your-youtube-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/integrations/youtube/callback"

# Content Calendar & Automated Scheduler Configuration
INSTAGRAM_SCHEDULE_GRACE_MINUTES=30
INSTAGRAM_SCHEDULE_MAX_ATTEMPTS=3

# Instagram Analytics & Performance Intelligence Configuration
INSTAGRAM_ANALYTICS_SYNC_HOURS=6
INSTAGRAM_ANALYTICS_MAX_ATTEMPTS=3

# N8n Automation & Webhook Integration Configuration
N8N_WEBHOOK_TIMEOUT_MS=10000
N8N_WEBHOOK_MAX_ATTEMPTS=5
N8N_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
N8N_WEBHOOK_MAX_PAYLOAD_BYTES=65536
N8N_RESPONSE_PREVIEW_MAX_BYTES=2048

# Redis Queue Connection (BullMQ)
REDIS_URL="redis://localhost:6379"

# Queue Worker Concurrency & Retry Settings
GENERATION_WORKER_CONCURRENCY=3
GENERATION_MAX_ATTEMPTS=3

# Opt-In Real API Integration Test Switches (Explicit Opt-In Only)
RUN_REAL_OPENAI_TEST="false"
RUN_REAL_INSTAGRAM_TEST="false"
RUN_REAL_LINKEDIN_TEST="false"
RUN_REAL_THREADS_TEST="false"
RUN_REAL_PINTEREST_TEST="false"
RUN_REAL_FACEBOOK_TEST="false"
RUN_REAL_TIKTOK_TEST="false"
RUN_REAL_YOUTUBE_TEST="false"
RUN_REAL_X_TEST="false"
RUN_REAL_REDDIT_TEST="false"
RUN_REAL_TELEGRAM_TEST="false"
RUN_REAL_BLUESKY_TEST="false"
RUN_REAL_SCHEDULING_TEST="false"
RUN_REAL_ANALYTICS_TEST="false"
RUN_REAL_N8N_TEST="false"
N8N_TEST_WEBHOOK_URL=""
