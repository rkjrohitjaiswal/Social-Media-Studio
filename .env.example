# ==============================================================================
# AI SOCIAL MEDIA STUDIO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with production values before starting.
# NEVER commit raw API keys, OAuth secrets, database credentials or encryption keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE & NETWORKING
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=4000
WEB_URL="https://app.aisocialstudio.com"
FRONTEND_URL="https://app.aisocialstudio.com"
API_URL="https://api.aisocialstudio.com"
NEXT_PUBLIC_API_URL="https://api.aisocialstudio.com"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Pooled database connection URL for production Prisma query engine
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true"
# Direct database connection URL for Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SUPABASE
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_SUPABASE_PROJECT_ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-public-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-private-service-role-key"

# ------------------------------------------------------------------------------
# 4. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# 64-character hex key (AES-256-GCM) for encrypting BYOK credentials at rest
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_CREDENTIAL_ENCRYPTION_KEY="your-64-character-hex-encryption-key"
ALLOW_SERVER_AI_FALLBACK="false"

# ------------------------------------------------------------------------------
# 5. AI PROVIDERS (Server-Side Fallback Defaults — BYOK Enabled)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-key-fallback"
GEMINI_API_KEY="AIza-your-gemini-key-fallback"
RUNWAY_API_KEY="rw-key-your-runway-key-fallback"
LUMA_API_KEY="luma-your-luma-key-fallback"
ELEVENLABS_API_KEY="el-key-your-elevenlabs-key-fallback"

# ------------------------------------------------------------------------------
# 6. SAAS BILLING & RAZORPAY
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
RAZORPAY_PRO_PLAN_ID="plan_pro_live_id"
RAZORPAY_ADVANCED_PLAN_ID="plan_advanced_live_id"
RAZORPAY_PREMIUM_PLAN_ID="plan_premium_live_id"
RAZORPAY_BUSINESS_PLAN_ID="plan_business_live_id"

# ------------------------------------------------------------------------------
# 7. SOCIAL PLATFORM OAUTH (Live Publishing Credentials)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID="your-youtube-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-youtube-client-secret"
YOUTUBE_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/youtube/callback"

INSTAGRAM_CLIENT_ID="your-instagram-app-id"
INSTAGRAM_CLIENT_SECRET="your-instagram-app-secret"
INSTAGRAM_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/instagram/callback"

TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"
TIKTOK_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/tiktok/callback"

FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
FACEBOOK_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/facebook/callback"

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/linkedin/callback"

X_CLIENT_ID="your-twitter-client-id"
X_CLIENT_SECRET="your-twitter-client-secret"
X_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/x/callback"

PINTEREST_CLIENT_ID="your-pinterest-app-id"
PINTEREST_CLIENT_SECRET="your-pinterest-app-secret"
PINTEREST_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/pinterest/callback"

THREADS_CLIENT_ID="your-threads-app-id"
THREADS_CLIENT_SECRET="your-threads-app-secret"
THREADS_REDIRECT_URI="https://api.aisocialstudio.com/api/integrations/threads/callback"

# ------------------------------------------------------------------------------
# 8. CRON & WORKERS
# ------------------------------------------------------------------------------
PUBLISHING_WORKER_INTERVAL_MS="10000"
ENABLE_BACKGROUND_PUBLISHING_WORKER="true"
